{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Vanilla Release build",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "CMAKE_FIND_FRAMEWORK": "LAST",
                "DSOUND": "OFF",
                "DDRAW": "OFF",
                "SDL2": "ON",
                "OPENAL": "ON"
            }
        },
        {
            "name": "remaster",
            "inherits": "release",
            "displayName": "Vanilla Remaster build",
            "cacheVariables": {
                "BUILD_REMASTERTD": "ON",
                "BUILD_REMASTERRA": "ON",
                "BUILD_VANILLATD": "OFF",
                "BUILD_VANILLARA": "OFF",
                "MAP_EDITORTD": "OFF",
                "MAP_EDITORRA": "OFF",
                "BUILD_TOOLS": "OFF"
            }
        },
        {
            "name": "internal",
            "inherits": "release",
            "displayName": "Vanilla Internal build",
            "cacheVariables": {
                "MAP_EDITORTD": "ON",
                "MAP_EDITORRA": "ON",
                "BUILD_TOOLS": "ON"
            }
        },
        {
            "name": "testing",
            "inherits": "release",
            "displayName": "Vanilla build with tests",
            "cacheVariables": {
                "BUILD_VANILLATD": "OFF",
                "BUILD_VANILLARA": "OFF",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "nonet",
            "inherits": "internal",
            "displayName": "Vanilla build no networking",
            "cacheVariables": {
                "NETWORKING": "OFF"
            }
        },
        {
            "name": "msvc2019-i686-remaster",
            "inherits": "remaster",
            "binaryDir": "${sourceDir}/build_remaster",
            "displayName": "MSVC 2019 32bit Remaster build",
            "generator": "Visual Studio 16 2019",
            "architecture": "Win32"
        },
        {
            "name": "msvc2019-i686-vanilla",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build_msvc32",
            "displayName": "MSVC 2019 32bit Vanilla build",
            "generator": "Visual Studio 16 2019",
            "architecture": "Win32"
        },
        {
            "name": "msvc2019-x86-64-vanilla",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build_msvc64",
            "displayName": "MSVC 2019 64bit Vanilla build",
            "architecture": "x64"
        },
        {
            "name": "ipados-simulator",
            "displayName": "iPadOS Simulator (Xcode)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/ipados-simulator",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH": "YES",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "/private/tmp/TiberianDawnApple-iPad-Simulator-Products",
                "BUILD_VANILLATD": "ON",
                "BUILD_VANILLARA": "OFF",
                "BUILD_REMASTERTD": "OFF",
                "BUILD_REMASTERRA": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_TOOLS": "OFF",
                "MAP_EDITORTD": "OFF",
                "NETWORKING": "ON",
                "SDL1": "OFF",
                "SDL2": "ON",
                "OPENAL": "ON"
            }
        },
        {
            "name": "ipados-device",
            "inherits": "ipados-simulator",
            "displayName": "iPadOS Device (Xcode)",
            "binaryDir": "${sourceDir}/build/ipados-device",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "/private/tmp/TiberianDawnApple-iPad-Device-Products",
                "IPADOS_BUNDLE_IDENTIFIER": "com.wireproof.tiberiandawn"
            }
        },
        {
            "name": "visionos-simulator",
            "displayName": "Tiberian Dawn for Vision Pro — Simulator Prototype",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/visionos-simulator",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "visionOS",
                "CMAKE_OSX_SYSROOT": "xrsimulator",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "2.0",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH": "YES",
                "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
                "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "/private/tmp/TiberianDawnApple-Vision-Simulator-Products",
                "BUILD_VANILLATD": "ON",
                "BUILD_VANILLARA": "OFF",
                "BUILD_REMASTERTD": "OFF",
                "BUILD_REMASTERRA": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_TOOLS": "OFF",
                "MAP_EDITORTD": "OFF",
                "NETWORKING": "ON",
                "SDL1": "OFF",
                "SDL2": "ON",
                "OPENAL": "OFF",
                "VISIONOS_PORT": "ON",
                "MAKE_BUNDLE": "ON"
            }
        },
        {
            "name": "visionos-device",
            "inherits": "visionos-simulator",
            "displayName": "Tiberian Dawn for Vision Pro — Device Prototype",
            "binaryDir": "${sourceDir}/build/visionos-device",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "xros",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "/private/tmp/TiberianDawnApple-Vision-Device-Products"
            }
        },
        {
            "name": "macos-universal",
            "displayName": "Tiberian Dawn for macOS — Universal App",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/macos-universal",
            "cacheVariables": {
                "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_FIND_FRAMEWORK": "FIRST",
                "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
                "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
                "BUILD_VANILLATD": "ON",
                "BUILD_VANILLARA": "OFF",
                "BUILD_REMASTERTD": "OFF",
                "BUILD_REMASTERRA": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_TOOLS": "OFF",
                "MAP_EDITORTD": "OFF",
                "NETWORKING": "ON",
                "SDL1": "OFF",
                "SDL2": "ON",
                "OPENAL": "OFF",
                "MACOS_PORT": "ON",
                "MAKE_BUNDLE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "remaster",
            "configurePreset": "remaster",
            "displayName": "Vanilla Game Build",
            "description": "Vanilla Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "displayName": "Vanilla Game Build",
            "description": "Vanilla Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "internal",
            "configurePreset": "internal",
            "displayName": "Vanilla Game Build",
            "description": "Vanilla Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "testing",
            "configurePreset": "testing",
            "displayName": "Vanilla Game Build",
            "description": "Vanilla Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "nonet",
            "configurePreset": "nonet",
            "displayName": "Vanilla Game Build",
            "description": "Vanilla Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "ipados-simulator",
            "configurePreset": "ipados-simulator",
            "displayName": "Tiberian Dawn for iPad — Simulator",
            "configuration": "Debug",
            "targets": ["TiberianDawn"]
        },
        {
            "name": "ipados-device",
            "configurePreset": "ipados-device",
            "displayName": "Tiberian Dawn for iPad — Device",
            "configuration": "Debug",
            "targets": ["TiberianDawn"]
        },
        {
            "name": "ipados-device-release",
            "configurePreset": "ipados-device",
            "displayName": "Tiberian Dawn for iPad — Release",
            "configuration": "Release",
            "targets": ["TiberianDawn"]
        },
        {
            "name": "visionos-simulator",
            "configurePreset": "visionos-simulator",
            "displayName": "Tiberian Dawn for Vision Pro — Simulator Prototype",
            "configuration": "Debug",
            "targets": ["TiberianDawn"]
        },
        {
            "name": "visionos-device",
            "configurePreset": "visionos-device",
            "displayName": "Tiberian Dawn for Vision Pro — Unsigned Device Prototype",
            "configuration": "Release",
            "targets": ["TiberianDawn"]
        },
        {
            "name": "macos-universal",
            "configurePreset": "macos-universal",
            "displayName": "Tiberian Dawn for macOS — Universal Release",
            "configuration": "Release",
            "targets": ["TiberianDawn"]
        }
    ],
    "testPresets": [
        {
            "name": "testing",
            "configurePreset": "testing",
            "configuration": "RelWithDebInfo",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                }
            ]
        },
        {
            "name": "remaster",
            "steps": [
                {
                    "type": "configure",
                    "name": "remaster"
                },
                {
                    "type": "build",
                    "name": "remaster"
                }
            ]
        },
        {
            "name": "internal",
            "steps": [
                {
                    "type": "configure",
                    "name": "internal"
                },
                {
                    "type": "build",
                    "name": "internal"
                }
            ]
        },
        {
            "name": "testing",
            "steps": [
                {
                    "type": "configure",
                    "name": "testing"
                },
                {
                    "type": "build",
                    "name": "testing"
                },
                {
                    "type": "test",
                    "name": "testing"
                }
            ]
        },
        {
            "name": "nonet",
            "steps": [
                {
                    "type": "configure",
                    "name": "nonet"
                },
                {
                    "type": "build",
                    "name": "nonet"
                }
            ]
        },
        {
            "name": "visionos-simulator",
            "steps": [
                {
                    "type": "configure",
                    "name": "visionos-simulator"
                },
                {
                    "type": "build",
                    "name": "visionos-simulator"
                }
            ]
        },
        {
            "name": "macos-universal",
            "steps": [
                {
                    "type": "configure",
                    "name": "macos-universal"
                },
                {
                    "type": "build",
                    "name": "macos-universal"
                }
            ]
        }
    ]
}
