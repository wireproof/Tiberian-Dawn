+{
+    if (!TiberianDawnBackgroundTaskActive) {
+        return;
+    }
+
+    UIBackgroundTaskIdentifier task = TiberianDawnBackgroundTask;
+    TiberianDawnBackgroundTaskActive = NO;
+    if (task != UIBackgroundTaskInvalid) {
