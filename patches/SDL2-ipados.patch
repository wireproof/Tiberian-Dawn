+void TiberianDawn_GetSafeAreaInsets(SDL_Window *window,
+                                 int outputWidth,
+                                 int outputHeight,
+                                 int *left,
+                                 int *top,
+                                 int *right,
+                                 int *bottom)
+{
+    if (left) *left = 0;
+    if (top) *top = 0;
+    if (right) *right = 0;
+    if (bottom) *bottom = 0;
+
+    if (!window || !window->driverdata || outputWidth <= 0 || outputHeight <= 0) {
+        return;
+    }
+
+    @autoreleasepool {
+        SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+        UIWindow *uiwindow = data.uiwindow;
+        const CGSize size = uiwindow.bounds.size;
+        if (!uiwindow || size.width <= 0.0 || size.height <= 0.0) {
+            return;
+        }
+
+        const UIEdgeInsets insets = uiwindow.safeAreaInsets;
+        const CGFloat scaleX = outputWidth / size.width;
+        const CGFloat scaleY = outputHeight / size.height;
+        if (left) *left = (int)(insets.left * scaleX + 0.5);
+        if (top) *top = (int)(insets.top * scaleY + 0.5);
+        if (right) *right = (int)(insets.right * scaleX + 0.5);
+        if (bottom) *bottom = (int)(insets.bottom * scaleY + 0.5);
+    }
+}
